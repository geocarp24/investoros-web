# InvestorOS web app — environment variables

# --- Database (Postgres / Supabase) ---
# Create free project at https://supabase.com (region us-east-1, 500MB free)
# Get connection strings from Project Settings → Database
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Credential vault encryption ---
# Used by src/lib/credentials.ts to encrypt/decrypt per-tenant credentials (AES-256-GCM)
# Generate with: openssl rand -base64 32
# DO NOT rotate without migration plan (existing rows become undecryptable)
ENCRYPTION_KEY=""

# --- App config ---
NEXT_PUBLIC_APP_URL="https://investoros.tech"
NEXT_PUBLIC_APP_DOMAIN="investoros.tech"
DEFAULT_TENANT_SLUG="pinnacle"

# --- Airtable (legacy per-tenant tokens — fallback when vault is empty) ---
# The credential vault (src/lib/credentials.ts) is now the source of truth for
# Airtable tokens. These env vars remain as fallback for Pinnacle / Geo Carpentry
# during the migration period. Once a tenant's credential is in the vault, the
# env var becomes unused.
AIRTABLE_TOKEN_GEO=""

# --- Auth (Clerk — Sprint B6 live 2026-05-27) ---
# Get keys at https://dashboard.clerk.com (free 10K MAU tier)
# Create app "InvestorOS" → API Keys tab → copy these two values
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Optional overrides (defaults work):
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/geo"
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/geo"
